{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug GameForge Compiler (F5)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/gamec.exe",
            "args": ["build", "games/space_invaders_gpu.game", "-o", "bin/space_invaders.exe"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\Users\\user\\w64devkit\\bin\\gdb.exe",
            "preLaunchTask": "Build GameForge Compiler (-O3, -march=native)",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Run Space Invaders GPU (F5)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/space_invaders.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\Users\\user\\w64devkit\\bin\\gdb.exe",
            "preLaunchTask": "Build Space Invaders (GPU OpenGL 3.3 + Shaders)",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Run Pong Arcade GPU (F5)",
